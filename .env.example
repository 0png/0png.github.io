# GitHub Personal Access Token — used at build time to fetch real contribution
# data for the Contact section heatmap. Requires no extra scopes for public repos
# (a classic PAT with zero scopes, or a fine-grained token with public read, works).
# Without this the heatmap falls back to generated placeholder data.
GITHUB_TOKEN=

# No other environment variables are required.
# Content is sourced from local markdown files in src/content/projects/.
