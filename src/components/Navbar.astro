---
const navLinks = [
  { label: 'HOME', href: '/' },
  { label: 'ABOUT', href: '/#about' },
  { label: 'PROJECTS', href: '/#projects' },
  { label: 'CHANGELOG', href: '/#changelog' },
]
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50"
  style="transform: translateY(-100%); opacity: 0;"
>
  <!-- Glassmorphism backdrop -->
  <div class="absolute inset-0 bg-black/50 backdrop-blur-md border-b border-neutral-800">
  </div>

  <nav class="relative max-w-7xl mx-auto px-6 md:px-10 h-16 flex items-center justify-between gap-6">

    <!-- Left: Logo -->
    <a
      href="/"
      class="font-mono font-black text-base tracking-tight text-white/90 hover:text-white transition-colors duration-200 shrink-0"
    >
      0<span class="text-white/35">PNG</span>
    </a>

    <!-- Center-right: Nav links -->
    <ul class="hidden md:flex items-center gap-1 flex-1 justify-center">
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href} class="nav-link group font-mono text-[12px] tracking-[0.2em] text-white/35 hover:text-white/90 transition-colors duration-150 px-3 py-1.5 flex items-center gap-0">
              <span class="text-white/20 group-hover:text-white/50 transition-colors duration-150">[ </span>
              {link.label}
              <span class="text-white/20 group-hover:text-white/50 transition-colors duration-150"> ]</span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Right: Status + mobile toggle -->
    <div class="flex items-center gap-4">
      <!-- Status indicator (desktop) -->
      <div class="hidden md:flex items-center gap-0 font-mono text-[12px] tracking-[0.15em]">
        <span class="text-white/20">[ </span>
        <span class="text-white/35">STATUS:&nbsp;</span>
        <span class="relative inline-flex items-center gap-1.5 text-emerald-400/80">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-400"></span>
          </span>
          ONLINE
        </span>
        <span class="text-white/20"> ]</span>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        aria-label="Toggle menu"
        class="md:hidden flex flex-col gap-[5px] p-1"
      >
        <span id="bar1" class="block w-5 h-px bg-white/40 hover:bg-white/70 transition-all duration-300 origin-center"></span>
        <span id="bar2" class="block w-5 h-px bg-white/40 hover:bg-white/70 transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden overflow-hidden"
    style="max-height: 0; transition: max-height 300ms ease-in-out;"
  >
    <div class="border-t border-neutral-800 px-6 py-5 flex flex-col gap-4">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link font-mono text-[12px] tracking-[0.2em] text-white/40 hover:text-white/90 transition-colors duration-150"
          >
            <span class="text-white/20">[ </span>{link.label}<span class="text-white/20"> ]</span>
          </a>
        ))
      }
      <!-- Status in mobile -->
      <div class="flex items-center gap-1.5 font-mono text-[12px] tracking-[0.15em] text-white/25 pt-1 border-t border-white/[0.04]">
        <span class="relative flex h-1.5 w-1.5 mr-0.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-400"></span>
        </span>
        STATUS: ONLINE
      </div>
    </div>
  </div>
</header>

<style>
  #navbar {
    /* CSS handles the hide/show transition after GSAP entrance completes */
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  #navbar.nav-entrance-done {
    /* Only enable scroll transition once GSAP entrance is done */
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1),
                opacity 280ms ease;
  }
  #navbar.nav-hidden {
    transform: translateY(-100%) !important;
  }
  #navbar.nav-visible {
    transform: translateY(0) !important;
  }
</style>

<script>
  import gsap from 'gsap'

  const navbar = document.getElementById('navbar') as HTMLElement

  // ── 1. Entrance animation ─────────────────────────────────────────────────
  gsap.fromTo(
    navbar,
    { y: -20, opacity: 0 },
    {
      y: 0,
      opacity: 1,
      duration: 0.55,
      ease: 'power2.out',
      delay: 0.15,
      clearProps: 'all', // hand control back to CSS after done
      onComplete: () => {
        navbar.classList.add('nav-entrance-done', 'nav-visible')
      },
    },
  )

  // ── 2. Smart hide/show on scroll ──────────────────────────────────────────
  let lastScrollY = 0
  let ticking = false
  let entranceDone = false

  // Poll until entrance is done, then activate scroll logic
  const entranceCheck = setInterval(() => {
    if (navbar.classList.contains('nav-entrance-done')) {
      entranceDone = true
      lastScrollY = window.scrollY
      clearInterval(entranceCheck)
    }
  }, 50)

  window.addEventListener(
    'scroll',
    () => {
      if (!entranceDone || ticking) return
      ticking = true

      requestAnimationFrame(() => {
        const currentScrollY = window.scrollY
        const scrollingDown = currentScrollY > lastScrollY
        const pastThreshold = currentScrollY > 80 // don't hide near the very top

        if (scrollingDown && pastThreshold) {
          navbar.classList.add('nav-hidden')
          navbar.classList.remove('nav-visible')
        } else {
          navbar.classList.remove('nav-hidden')
          navbar.classList.add('nav-visible')
        }

        // Slightly tighten backdrop when scrolled
        const backdrop = navbar.querySelector('div') as HTMLElement
        if (backdrop) {
          backdrop.style.borderColor =
            currentScrollY > 20 ? 'rgb(38 38 38)' : 'rgb(23 23 23)'
        }

        lastScrollY = currentScrollY
        ticking = false
      })
    },
    { passive: true },
  )

  // ── 3. Mobile menu ────────────────────────────────────────────────────────
  const toggle = document.getElementById('menu-toggle')
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement
  const bar1 = document.getElementById('bar1') as HTMLElement
  const bar2 = document.getElementById('bar2') as HTMLElement
  let menuOpen = false

  toggle?.addEventListener('click', () => {
    menuOpen = !menuOpen
    mobileMenu.style.maxHeight = menuOpen ? `${mobileMenu.scrollHeight}px` : '0'
    bar1.style.transform = menuOpen ? 'translateY(6px) rotate(45deg)' : ''
    bar2.style.transform = menuOpen ? 'translateY(-0.5px) rotate(-45deg)' : ''
  })

  mobileMenu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menuOpen = false
      mobileMenu.style.maxHeight = '0'
      bar1.style.transform = ''
      bar2.style.transform = ''
    })
  })
</script>
