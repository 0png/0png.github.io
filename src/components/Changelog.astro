---
/**
 * Changelog.astro — reusable zigzag timeline renderer.
 *
 * Imports src/data/changelog.json at build time.
 * Gracefully handles an empty array or entries with missing fields.
 *
 * Props:
 *   limit?: number  — cap the number of entries shown (default: all)
 *   repoBase?: string — base URL for commit hash links
 */

interface Props {
  limit?: number
  repoBase?: string
}

const { limit, repoBase = 'https://github.com/0png/0png/commit' } = Astro.props

// ── Data ──────────────────────────────────────────────────────────────────────

import rawData from '@/data/changelog.json'

type Entry = { date?: unknown; subject?: unknown; body?: unknown; hash?: unknown }

// Runtime shape validation — guards against malformed JSON at build time.
function isValidEntry(e: unknown): e is { date: string; subject: string; body: string; hash: string } {
  if (!e || typeof e !== 'object') return false
  const o = e as Record<string, unknown>
  return (
    typeof o.date    === 'string' && o.date.length > 0 &&
    typeof o.subject === 'string' && o.subject.length > 0 &&
    typeof o.hash    === 'string' && o.hash.length > 0
  )
}

const allEntries = Array.isArray(rawData)
  ? (rawData as Entry[]).filter(isValidEntry)
  : []

const entries = typeof limit === 'number' && limit > 0
  ? allEntries.slice(0, limit)
  : allEntries

// ── Helpers ───────────────────────────────────────────────────────────────────

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    })
  } catch {
    return iso
  }
}

function cleanBody(raw: string): string {
  return (raw ?? '')
    .split('\n')
    .filter((line) => !/^co-authored-by:/i.test(line.trim()))
    .join('\n')
    .trim()
}

type TypeMeta = { label: string; cls: string }
function getType(subject: string): TypeMeta {
  const s = subject.toLowerCase()
  if (s.startsWith('feat:'))
    return { label: 'feat', cls: 'text-emerald-400 border-emerald-400/30 bg-emerald-400/[0.06]' }
  if (s.startsWith('fix:'))
    return { label: 'fix', cls: 'text-rose-400 border-rose-400/30 bg-rose-400/[0.06]' }
  if (s.startsWith('refactor:'))
    return { label: 'refactor', cls: 'text-sky-400 border-sky-400/30 bg-sky-400/[0.06]' }
  if (s.startsWith('chore:'))
    return { label: 'chore', cls: 'text-zinc-400 border-zinc-400/30 bg-zinc-400/[0.06]' }
  return { label: 'misc', cls: 'text-amber-400 border-amber-400/30 bg-amber-400/[0.06]' }
}

function stripPrefix(s: string): string {
  return s.replace(/^[a-z]+:\s*/i, '')
}
---

{entries.length === 0 ? (
  <div class="flex items-center gap-3 border border-white/[0.05] px-5 py-4 font-mono text-xs text-white/25">
    <span class="text-white/15">$</span>
    <span>No changelog entries found.</span>
  </div>
) : (
  <ol class="relative cl-timeline" aria-label="Changelog timeline">
    <!-- Vertical spine -->
    <div
      class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-px pointer-events-none"
      style="background: linear-gradient(to bottom, transparent 0%, rgba(251,191,36,0.14) 8%, rgba(251,191,36,0.14) 92%, transparent 100%);"
      aria-hidden="true"
    />

    {entries.map((entry, i) => {
      const isLeft  = i % 2 === 0
      const body    = cleanBody(entry.body)
      const type    = getType(entry.subject)
      const title   = stripPrefix(entry.subject)

      const card = (
        <article class="cl-card group relative rounded-sm border border-white/[0.06] bg-neutral-950/55 px-5 py-5 backdrop-blur-sm transition-all duration-300 hover:border-amber-400/[0.16] hover:shadow-[0_0_28px_rgba(251,191,36,0.045)] hover:bg-neutral-950/70">
          {/* Inner top highlight */}
          <div
            class="pointer-events-none absolute inset-x-0 top-0 h-px rounded-t-sm"
            style="background: linear-gradient(to right, transparent, rgba(255,255,255,0.04), transparent);"
            aria-hidden="true"
          />

          {/* Type badge + date */}
          <div class="flex items-center justify-between gap-3 mb-3">
            <span class={`inline-flex items-center rounded-sm border px-2 py-[3px] font-mono text-[10px] font-semibold uppercase tracking-widest ${type.cls}`}>
              {type.label}
            </span>
            <time datetime={entry.date} class="font-mono text-[11px] text-white/25">
              {formatDate(entry.date)}
            </time>
          </div>

          {/* Subject */}
          <h3 class="text-[14px] font-semibold leading-snug text-neutral-100 tracking-[-0.01em]">
            {title}
          </h3>

          {/* Body */}
          {body && (
            <p class="mt-3 border-t border-white/[0.05] pt-3 font-sans text-[12px] leading-relaxed text-neutral-500 whitespace-pre-line">
              {body}
            </p>
          )}

          {/* Footer: SHA-1 hash link */}
          <div class="mt-4 flex items-center justify-between border-t border-white/[0.04] pt-3">
            <span class="font-mono text-[10px] text-white/12 tracking-widest">SHA-1</span>
            <a
              href={`${repoBase}/${entry.hash}`}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[11px] text-neutral-600 hover:text-amber-400 transition-colors duration-200"
              aria-label={`View commit ${entry.hash} on GitHub`}
            >
              {entry.hash}
            </a>
          </div>
        </article>
      )

      return (
        <li
          class="relative grid grid-cols-[1fr_48px_1fr] items-start pb-12 last:pb-0"
          data-cl-item
        >
          {/* Left slot */}
          <div class={isLeft ? 'col-start-1 pr-7' : 'col-start-1'}>
            {isLeft && card}
          </div>

          {/* Center node */}
          <div class="col-start-2 relative z-10 flex justify-center pt-[18px]">
            <div class="relative flex items-center justify-center">
              <div
                class="absolute h-5 w-5 rounded-full bg-amber-400/[0.08] animate-pulse"
                aria-hidden="true"
              />
              <div class="relative h-[11px] w-[11px] rounded-full border border-amber-400/55 bg-neutral-950 shadow-[0_0_8px_rgba(251,191,36,0.22)]" />
            </div>
          </div>

          {/* Right slot */}
          <div class={!isLeft ? 'col-start-3 pl-7' : 'col-start-3'}>
            {!isLeft && card}
          </div>
        </li>
      )
    })}
  </ol>
)}

<script>
  import gsap from 'gsap'
  import ScrollTrigger from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  // Scope to .cl-timeline so multiple instances on the same page don't collide.
  document.querySelectorAll<HTMLElement>('.cl-timeline [data-cl-item]').forEach((item) => {
    const card = item.querySelector<HTMLElement>('.cl-card')
    if (!card) return

    gsap.fromTo(
      card,
      { autoAlpha: 0, y: 22 },
      {
        autoAlpha: 1,
        y: 0,
        duration: 0.65,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 88%',
        },
      },
    )
  })
</script>
