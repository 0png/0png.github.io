---
import type { Project } from '@/data/projects'
import ProjectCard from '@/components/ProjectCard.astro'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<section
  id="projects-section"
  class="relative overflow-hidden"
  aria-label="Projects"
>
  <!-- Section header -->
  <div class="px-8 pb-8 pt-16 md:px-16">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-white/30">
      Selected work
    </p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-foreground md:text-4xl">
      Projects
    </h2>
  </div>

  <!-- Scroll track: w-max gives the flex row its natural full width so
       offsetWidth = total cards width, which GSAP reads correctly -->
  <div
    id="projects-track"
    class="flex flex-col gap-6 px-8 pb-16 md:w-max md:flex-row md:flex-nowrap md:items-stretch md:px-16 md:pb-0"
  >
    {projects.map((project) => <ProjectCard project={project} />)}
    <!-- Trailing spacer so last card doesn't sit flush against viewport edge -->
    <div class="hidden w-16 shrink-0 md:block" aria-hidden="true" />
  </div>
</section>

<script>
  import { initHorizontalScroll } from '@/lib/horizontalScroll'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  const section = document.getElementById('projects-section')
  const track = document.getElementById('projects-track')

  if (section && track) {
    // Defer setup until the browser has finished painting so offsetWidth
    // reflects the real laid-out dimensions, not a mid-parse snapshot.
    requestAnimationFrame(() => {
      if (window.innerWidth >= 768) {
        initHorizontalScroll(section, track)
      }

      // ResizeObserver fires only when the section's dimensions actually
      // change — more efficient and accurate than window 'resize'.
      const ro = new ResizeObserver(() => {
        ScrollTrigger.refresh()
      })
      ro.observe(section)
    })
  }
</script>
