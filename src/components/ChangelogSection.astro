---
import changelog from '@/data/changelog.json'

type Entry = { date: string; subject: string; body: string; hash: string }

const SKIP_PREFIXES = ['ci:', 'init:', 'test:']
const entries = (changelog as Entry[])
  .filter((e) => !SKIP_PREFIXES.some((p) => e.subject.toLowerCase().startsWith(p)))
  .slice(0, 3)

const repoBase = 'https://github.com/0png/0png/commit'

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  })
}

function cleanBody(raw: string): string {
  return raw
    .split('\n')
    .filter((line) => !/^co-authored-by:/i.test(line.trim()))
    .join('\n')
    .trim()
}

type TypeMeta = { label: string; cls: string }
function getType(subject: string): TypeMeta {
  const s = subject.toLowerCase()
  if (s.startsWith('feat:'))
    return { label: 'feat', cls: 'text-emerald-400 border-emerald-400/30 bg-emerald-400/[0.06]' }
  if (s.startsWith('fix:'))
    return { label: 'fix', cls: 'text-rose-400 border-rose-400/30 bg-rose-400/[0.06]' }
  if (s.startsWith('refactor:'))
    return { label: 'refactor', cls: 'text-sky-400 border-sky-400/30 bg-sky-400/[0.06]' }
  if (s.startsWith('chore:'))
    return { label: 'chore', cls: 'text-zinc-400 border-zinc-400/30 bg-zinc-400/[0.06]' }
  return { label: 'misc', cls: 'text-amber-400 border-amber-400/30 bg-amber-400/[0.06]' }
}

function stripPrefix(s: string): string {
  return s.replace(/^[a-z]+:\s*/i, '')
}
---

<section
  id="changelog"
  class="relative overflow-hidden px-6 py-20 md:px-8 md:py-28"
  aria-label="Changelog"
>
  <!-- Section-scoped vignette (non-fixed, relative to section) -->
  <div
    class="changelog-bg pointer-events-none absolute inset-0 z-0"
    style="background: radial-gradient(ellipse 60% 50% at 100% 100%, rgba(88,28,135,0.08) 0%, transparent 65%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto max-w-5xl">
    <!-- Section header -->
    <div class="mb-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.35em] text-white/20">
        git log --pretty=format:"%h %s" --no-merges
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl">
        CHANGELOG
      </h2>
    </div>

    <!-- Zigzag Timeline -->
    <ol id="changelog-list" class="relative" aria-label="Recent commits">
      <!-- Vertical spine: left-aligned on mobile, centered on desktop -->
      <div
        class="absolute left-3 md:left-1/2 top-0 bottom-0 w-px overflow-hidden md:-translate-x-px"
        style="background: linear-gradient(to bottom, transparent 0%, rgba(251,191,36,0.14) 10%, rgba(251,191,36,0.14) 90%, transparent 100%);"
        aria-hidden="true"
      >
        <div class="changelog-spine-progress absolute inset-x-0 top-0 h-full origin-top scale-y-0 bg-gradient-to-b from-transparent via-amber-400/70 to-transparent shadow-[0_0_18px_rgba(251,191,36,0.45)]"></div>
      </div>

      {
        entries.map((entry, i) => {
          const isLeft = i % 2 === 0
          const body = cleanBody(entry.body)
          const type = getType(entry.subject)
          const title = stripPrefix(entry.subject)

          const card = (
            <article class="cl-section-card group relative rounded-sm border border-white/[0.06] bg-neutral-950/55 px-5 py-5 backdrop-blur-sm transition-all duration-300 hover:border-amber-400/[0.16] hover:shadow-[0_0_28px_rgba(251,191,36,0.045)] hover:bg-neutral-950/70">
              {/* Inner top highlight */}
              <div
                class="pointer-events-none absolute inset-x-0 top-0 h-px rounded-t-sm"
                style="background: linear-gradient(to right, transparent, rgba(255,255,255,0.04), transparent);"
                aria-hidden="true"
              />

              {/* Type badge + date */}
              <div class="flex items-center justify-between gap-3 mb-3">
                <span
                  class={`inline-flex items-center rounded-sm border px-2 py-[3px] font-mono text-[10px] font-semibold uppercase tracking-widest ${type.cls}`}
                >
                  {type.label}
                </span>
                <time datetime={entry.date} class="font-mono text-[11px] text-white/25">
                  {formatDate(entry.date)}
                </time>
              </div>

              {/* Subject */}
              <h3 class="break-words text-[14px] font-semibold leading-snug text-neutral-100 tracking-[-0.01em]">
                {title}
              </h3>

              {/* Body */}
              {body && (
                <div>
                  <p
                    class="cl-body-text mt-3 border-t border-white/[0.05] pt-3 font-sans text-[12px] leading-relaxed text-neutral-500 whitespace-pre-line break-words"
                    style="--cl-lines: 2"
                    data-body-text
                  >
                    {body}
                  </p>
                  <button
                    type="button"
                    class="read-more-btn mt-2 hidden font-mono text-[10px] text-amber-400/60 transition-colors hover:text-amber-400"
                    aria-expanded="false"
                  >
                    Read more ↓
                  </button>
                </div>
              )}

              {/* Footer: hash */}
              <div class="mt-4 flex items-center justify-between border-t border-white/[0.04] pt-3">
                <span class="font-mono text-[10px] text-white/12 tracking-widest">SHA-1</span>
                <a
                  href={`${repoBase}/${entry.hash}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cl-hash font-mono text-[11px] text-neutral-600 hover:text-amber-400 transition-colors duration-200"
                  data-hash={entry.hash}
                  aria-label={`View commit ${entry.hash} on GitHub`}
                >
                  {entry.hash}
                </a>
              </div>
            </article>
          )

          return (
            <li
              class="relative grid grid-cols-[24px_1fr] md:grid-cols-[1fr_48px_1fr] items-start pb-12 last:pb-0"
              data-cl-section-item
            >
              {/* Node: col 1 on mobile, col 2 on desktop */}
              <div class="col-start-1 row-start-1 md:col-start-2 relative z-10 flex justify-center pt-[18px]">
                <div class="cl-node relative flex items-center justify-center">
                  <div
                    class="absolute h-5 w-5 rounded-full bg-amber-400/[0.08] animate-pulse"
                    aria-hidden="true"
                  />
                  <div class="relative h-[11px] w-[11px] rounded-full border border-amber-400/55 bg-neutral-950 shadow-[0_0_8px_rgba(251,191,36,0.22)]" />
                </div>
              </div>

              {/* Card: col 2 on mobile (always), alternates col 1/3 on desktop */}
              <div
                class={`col-start-2 row-start-1 pl-4 md:pl-0 ${isLeft ? 'md:col-start-1 md:col-end-2 md:pr-7' : 'md:col-start-3 md:pl-7'}`}
              >
                {card}
              </div>
            </li>
          )
        })
      }
    </ol>

    <!-- "View Full Changelog" button -->
    <div class="mt-12">
      <a
        href="/changelog"
        class="flex w-full items-center justify-center gap-3 border border-white/[0.07] bg-transparent px-6 py-4 font-mono text-sm text-white/40 transition-all duration-200 hover:border-amber-400/25 hover:text-white/70 hover:shadow-[0_0_20px_rgba(251,191,36,0.04)]"
      >
        <span class="text-white/25">$</span>
        View Full Changelog
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cl-body-text:not([data-expanded='true']) {
    display: -webkit-box;
    -webkit-line-clamp: var(--cl-lines, 2);
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  import gsap from 'gsap'
  import ScrollTrigger from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const section = document.getElementById('changelog')!
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Background vignette parallax
  if (!reduceMotion) {
    gsap.to(section.querySelector('.changelog-bg'), {
      yPercent: -25,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1,
      },
    })

    gsap.to(section.querySelector('.changelog-spine-progress'), {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: '#changelog-list',
        start: 'top 72%',
        end: 'bottom 68%',
        scrub: true,
      },
    })
  } else {
    gsap.set(section.querySelector('.changelog-spine-progress'), { scaleY: 1 })
  }

  function scrambleHash(el: HTMLElement) {
    const final = el.dataset.hash ?? el.textContent ?? ''
    const glyphs = '0123456789abcdef'
    let frame = 0
    const maxFrames = 14

    const tick = () => {
      frame += 1
      el.textContent = final
        .split('')
        .map((char, i) => (i < Math.floor((frame / maxFrames) * final.length) ? char : glyphs[Math.floor(Math.random() * glyphs.length)]))
        .join('')

      if (frame < maxFrames) {
        window.requestAnimationFrame(tick)
      } else {
        el.textContent = final
      }
    }

    tick()
  }

  document.querySelectorAll<HTMLElement>('[data-cl-section-item]').forEach((item, i) => {
    const card = item.querySelector<HTMLElement>('.cl-section-card')
    const node = item.querySelector<HTMLElement>('.cl-node')
    const hash = item.querySelector<HTMLElement>('.cl-hash')
    if (!card) return

    // Entry reveal
    gsap.fromTo(
      card,
      { autoAlpha: 0, y: 22 },
      {
        autoAlpha: 1,
        y: 0,
        duration: 0.65,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 88%',
          onEnter: () => {
            if (!reduceMotion && hash && !hash.dataset.scrambled) {
              hash.dataset.scrambled = 'true'
              scrambleHash(hash)
            }
            if (!reduceMotion && node) {
              gsap.fromTo(
                node,
                { scale: 0.72, filter: 'drop-shadow(0 0 0 rgba(251,191,36,0))' },
                { scale: 1, filter: 'drop-shadow(0 0 18px rgba(251,191,36,0.55))', duration: 0.42, ease: 'back.out(1.7)' },
              )
            }
          },
        },
      },
    )

    // Staggered scroll-depth parallax — alternating sides drift at different speeds
    const isLeft = i % 2 === 0
    if (!reduceMotion) {
      gsap.to(card, {
        yPercent: isLeft ? -10 : -5,
        ease: 'none',
        scrollTrigger: {
          trigger: item,
          start: 'top bottom',
          end: 'bottom top',
          scrub: isLeft ? 2 : 1.2,
        },
      })
    }
  })

  function setupExpandableBodies() {
    document.querySelectorAll<HTMLElement>('[data-body-text]').forEach((p) => {
      const btn = p.nextElementSibling as HTMLButtonElement | null
      if (!btn?.classList.contains('read-more-btn')) return

      const expanded = btn.getAttribute('aria-expanded') === 'true'
      p.dataset.expanded = String(expanded)
      btn.textContent = expanded ? 'Read less ↑' : 'Read more ↓'

      const overflows = p.scrollHeight > p.clientHeight + 1
      btn.classList.toggle('hidden', !expanded && !overflows)

      if (!btn.dataset.bound) {
        btn.dataset.bound = '1'
        btn.addEventListener('click', () => {
          const nextExpanded = btn.getAttribute('aria-expanded') !== 'true'
          btn.setAttribute('aria-expanded', String(nextExpanded))
          p.dataset.expanded = String(nextExpanded)
          btn.textContent = nextExpanded ? 'Read less ↑' : 'Read more ↓'
          btn.classList.remove('hidden')
        })
      }
    })
  }

  setupExpandableBodies()
  window.addEventListener('resize', setupExpandableBodies, { passive: true })
</script>
