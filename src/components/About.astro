---
interface Props {
  bio: string
}

const { bio: _bio } = Astro.props
---

<section
  id="about"
  class="relative flex min-h-screen flex-col"
  aria-label="About"
>
  <!-- ── Background layer ──────────────────────────────────── -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <!-- Grid -->
    <div class="about-grid absolute inset-0" />
    <!-- Central top spotlight — lights up the grid beneath it -->
    <div class="about-spotlight absolute" />
    <!-- Corner orbs -->
    <div class="about-orb-1 absolute" />
    <div class="about-orb-2 absolute" />
  </div>

  <!-- ── HUD overlay (desktop only) ───────────────────────── -->
  <div class="pointer-events-none absolute inset-0 z-30 hidden md:block" aria-hidden="true">

    <!-- Top-left: real-time HKT clock -->
    <div class="absolute left-8 top-8 lg:left-14 lg:top-10">
      <p class="font-mono text-[10px] uppercase tracking-widest text-neutral-500">System_Time // HKT (GMT+8)</p>
      <p id="hud-clock" class="mt-1 font-mono text-[10px] uppercase tracking-widest text-neutral-300">--:--:--</p>
    </div>

    <!-- Top-right: geo coordinates -->
    <div class="absolute right-8 top-8 text-right lg:right-14 lg:top-10">
      <p class="font-mono text-[10px] uppercase tracking-widest text-neutral-500">Location // HK_GEO</p>
      <p class="mt-1 font-mono text-[10px] uppercase tracking-widest text-neutral-300">22.3°N &nbsp;114.1°E</p>
    </div>

    <!-- Bottom-left: visitor public IP -->
    <div class="absolute bottom-8 left-8 lg:bottom-10 lg:left-14">
      <p class="font-mono text-[10px] uppercase tracking-widest text-neutral-500">Connection // IP_Address</p>
      <p id="hud-ip" class="mt-1 font-mono text-[10px] uppercase tracking-widest text-neutral-300">Resolving...</p>
    </div>

    <!-- Bottom-right: reserved for marquee below -->
    <div class="absolute bottom-8 right-8 text-right lg:bottom-10 lg:right-14">
      <p class="font-mono text-[10px] uppercase tracking-widest text-neutral-500">// Stack_Data</p>
      <p class="mt-1 font-mono text-[10px] uppercase tracking-widest text-neutral-300">↓ Scroll</p>
    </div>

  </div>

  <!-- Edge vignettes (blend into adjacent sections) -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-10 h-40"
    style="background: linear-gradient(to bottom, hsl(var(--background)), transparent);"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-40"
    style="background: linear-gradient(to top, hsl(var(--background)), transparent);"
    aria-hidden="true"
  />

  <!-- ── Content ───────────────────────────────────────────── -->
  <div class="relative z-20 flex flex-1 flex-col px-8 md:px-16">

    <!-- Section label -->
    <div class="about-header pt-20 pb-12 md:pt-24">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-white/30">
        01 // About Me
      </p>
    </div>

    <!-- Two-column grid — fills remaining vertical space -->
    <div class="flex flex-1 items-center pb-20">
      <div class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-14 md:grid-cols-2">

        <!-- Left: Avatar card -->
        <div class="about-avatar group relative flex w-full items-center justify-center py-10">
          <!-- Subtle bottom glow -->
          <div class="avatar-glow pointer-events-none absolute inset-x-0 bottom-0 h-1/3" />
          <!-- Image — constrained width so it doesn't overwhelm the panel -->
          <img
            src="/icon.png"
            alt="0PNG avatar"
            class="relative z-10 w-full max-w-[260px] rounded-lg grayscale transition-[filter,transform] duration-700 group-hover:scale-[1.02] group-hover:grayscale-0"
          />
          <!-- Scanlines on hover -->
          <div class="avatar-scanlines pointer-events-none absolute inset-0 z-20 opacity-0 transition-opacity duration-500 group-hover:opacity-100" />
        </div>

        <!-- Right: Terminal window -->
        <div class="about-terminal w-full max-w-[60ch] overflow-hidden rounded-xl border border-white/[0.08] bg-neutral-950 shadow-2xl">

          <!-- macOS window chrome -->
          <div class="flex items-center gap-2 border-b border-white/[0.07] bg-black/80 px-4 py-3">

            <!-- Red — close -->
            <button
              class="group relative flex h-3 w-3 items-center justify-center rounded-full bg-[#ff5f57]"
              aria-hidden="true"
              tabindex="-1"
            >
              <svg class="absolute opacity-0 transition-opacity duration-150 group-hover:opacity-100" width="6" height="6" viewBox="0 0 6 6" fill="none">
                <path d="M1 1l4 4M5 1L1 5" stroke="#6b0000" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>

            <!-- Yellow — minimise -->
            <button
              class="group relative flex h-3 w-3 items-center justify-center rounded-full bg-[#febc2e]"
              aria-hidden="true"
              tabindex="-1"
            >
              <svg class="absolute opacity-0 transition-opacity duration-150 group-hover:opacity-100" width="6" height="6" viewBox="0 0 6 6" fill="none">
                <path d="M1 3h4" stroke="#5a3a00" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>

            <!-- Green — expand -->
            <button
              class="group relative flex h-3 w-3 items-center justify-center rounded-full bg-[#28c840]"
              aria-hidden="true"
              tabindex="-1"
            >
              <svg class="absolute opacity-0 transition-opacity duration-150 group-hover:opacity-100" width="6" height="6" viewBox="0 0 6 6" fill="none">
                <path d="M3 1v4M1 3h4" stroke="#004010" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </button>

            <span class="ml-4 font-mono text-xs text-white/25">~/0png — zsh</span>
          </div>

          <!-- Terminal body -->
          <div class="space-y-5 p-5 font-mono text-sm leading-relaxed">

            <!-- whoami -->
            <div>
              <p class="term-line">
                <span class="text-[#61afef]">$</span>
                <span class="ml-2 text-[#98c379]">whoami</span>
              </p>
              <p class="term-line mt-1 text-white/75">
                <span class="text-[#c678dd]">&gt;</span>
                <span class="ml-2">0PNG</span>
                <span class="ml-1 text-white/40">(Student &amp; AI Developer based in HK)</span>
              </p>
            </div>

            <!-- cat about_me.txt -->
            <div>
              <p class="term-line">
                <span class="text-[#61afef]">$</span>
                <span class="ml-2 text-[#98c379]">cat</span>
                <span class="ml-2 text-[#e5c07b]">about_me.txt</span>
              </p>
              <p class="term-line mt-1 text-white/75">
                <span class="text-[#c678dd]">&gt;</span>
                <span class="ml-2">I focus on turning ideas into functional tools</span>
              </p>
              <p class="term-line text-white/75">
                <span class="text-[#c678dd]">&gt;</span>
                <span class="ml-2">by leveraging AI to solve daily problems and</span>
              </p>
              <p class="term-line text-white/75">
                <span class="text-[#c678dd]">&gt;</span>
                <span class="ml-2">supercharge my study workflow.</span>
              </p>
            </div>

            <!-- hobby.sh -->
            <div>
              <p class="term-line">
                <span class="text-[#61afef]">$</span>
                <span class="ml-2 text-[#98c379]">hobby.sh</span>
                <span class="ml-2 text-[#56b6c2]">--status</span>
                <span class="ml-2 text-[#e06c75]">running</span>
              </p>
              <p class="term-line mt-1 text-white/75">
                <span class="text-[#c678dd]">&gt;</span>
                <span class="ml-2">When not coding, I'm out on a run</span>
              </p>
              <p class="term-line text-white/75">
                <span class="text-[#c678dd]">&gt;</span>
                <span class="ml-2">the perfect reset before the next build.</span>
              </p>
            </div>

            <!-- Blinking cursor -->
            <div>
              <p class="term-line">
                <span class="text-[#61afef]">$</span>
                <span class="ml-2 animate-pulse text-white/50">_</span>
              </p>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  /* ── Background: grid ─────────────────────────────────────── */
  .about-grid {
    /* Brighter lines + glowing dot at every intersection */
    background-image:
      /* Intersection glow dots */
      radial-gradient(circle, rgba(255, 255, 255, 0.18) 1px, transparent 1px),
      /* Vertical lines */
      linear-gradient(to right,  rgba(255, 255, 255, 0.07) 1px, transparent 1px),
      /* Horizontal lines */
      linear-gradient(to bottom, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 40px 40px, 40px 40px, 40px 40px;
  }

  /* ── Central spotlight — paints light onto the grid ──────── */
  .about-spotlight {
    width: 70vw;
    height: 60vh;
    top: 5%;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(
      ellipse closest-side,
      rgba(255, 255, 255, 0.09) 0%,
      rgba(255, 255, 255, 0.03) 45%,
      transparent 100%
    );
    filter: blur(40px);
  }

  /* ── Atmospheric orbs ─────────────────────────────────────── */
  .about-orb-1 {
    width: clamp(400px, 55vw, 800px);
    height: clamp(400px, 55vw, 800px);
    top: -20%;
    right: -10%;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 255, 0.11) 0%,
      transparent 100%
    );
    filter: blur(70px);
  }

  .about-orb-2 {
    width: clamp(250px, 35vw, 500px);
    height: clamp(250px, 35vw, 500px);
    bottom: -10%;
    left: 5%;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 255, 0.08) 0%,
      transparent 100%
    );
    filter: blur(60px);
  }

  /* ── Avatar card ──────────────────────────────────────────── */
  .avatar-glow {
    background: radial-gradient(ellipse at bottom, rgba(255, 255, 255, 0.12) 0%, transparent 75%);
    filter: blur(24px);
  }

  /* ── Avatar: scanlines effect on hover ───────────────────── */
  .avatar-scanlines {
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.12) 2px,
      rgba(0, 0, 0, 0.12) 4px
    );
  }

  /* ── GSAP initial states ──────────────────────────────────── */
  .about-header {
    opacity: 0;
    transform: translateY(-10px);
  }
  .about-avatar {
    opacity: 0;
    transform: translateY(28px);
  }
  .about-terminal {
    opacity: 0;
    transform: translateY(28px);
  }
  .term-line {
    opacity: 0;
    transform: translateY(8px);
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .about-header,
    .about-avatar,
    .about-terminal,
    .term-line {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const section  = document.getElementById('about')!
  const header   = section.querySelector<HTMLElement>('.about-header')!
  const avatar   = section.querySelector<HTMLElement>('.about-avatar')!
  const terminal = section.querySelector<HTMLElement>('.about-terminal')!
  const lines    = section.querySelectorAll<HTMLElement>('.term-line')

  // ── Entry reveal + typewriter ──────────────────────────────
  gsap
    .timeline({
      scrollTrigger: { trigger: section, start: 'top 70%', once: true },
      defaults: { ease: 'power3.out' },
    })
    .to(header,   { opacity: 1, y: 0, duration: 0.5 })
    .to(avatar,   { opacity: 1, y: 0, duration: 0.75 }, '-=0.2')
    .to(terminal, { opacity: 1, y: 0, duration: 0.75 }, '-=0.55')
    .to(lines, { opacity: 1, y: 0, duration: 0.28, stagger: 0.09, ease: 'power2.out' }, '-=0.1')

  // ── HUD: real-time clock (HKT = UTC+8) ────────────────────
  function tickClock() {
    const el = document.getElementById('hud-clock')
    if (!el) return
    el.textContent = new Date().toLocaleTimeString('en-HK', {
      timeZone: 'Asia/Hong_Kong',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    })
  }
  tickClock()
  setInterval(tickClock, 1000)

  // ── HUD: visitor public IP ─────────────────────────────────
  fetch('https://api.ipify.org?format=json')
    .then((r) => r.json())
    .then(({ ip }: { ip: string }) => {
      const el = document.getElementById('hud-ip')
      if (el) el.textContent = ip
    })
    .catch(() => {
      const el = document.getElementById('hud-ip')
      if (el) el.textContent = '—'
    })

  gsap.to(avatar, {
    yPercent: -8,
    ease: 'none',
    scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2 },
  })

  gsap.to(terminal, {
    yPercent: -4,
    ease: 'none',
    scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 0.9 },
  })

  // ── Background layer parallax (multi-depth) ────────────────
  const orb1 = section.querySelector<HTMLElement>('.about-orb-1')
  const orb2 = section.querySelector<HTMLElement>('.about-orb-2')
  const grid = section.querySelector<HTMLElement>('.about-grid')
  const spotlight = section.querySelector<HTMLElement>('.about-spotlight')

  if (orb1) {
    gsap.to(orb1, {
      yPercent: -30,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 1.5 },
    })
  }
  if (orb2) {
    gsap.to(orb2, {
      yPercent: -18,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2.5 },
    })
  }
  if (grid) {
    gsap.to(grid, {
      yPercent: -8,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 3 },
    })
  }
  if (spotlight) {
    gsap.to(spotlight, {
      yPercent: -20,
      ease: 'none',
      scrollTrigger: { trigger: section, start: 'top bottom', end: 'bottom top', scrub: 2 },
    })
  }
</script>
