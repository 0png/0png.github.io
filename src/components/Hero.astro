---
import { badgeVariants } from '@/components/ui/badge'

interface Props {
  headline: string
}

const { headline } = Astro.props
const words = headline.split(' ')
---

<section
  id="hero"
  class="relative flex min-h-screen items-center justify-center overflow-hidden px-6"
>
  <!-- Animated orbs — primary light sources -->
  <div class="hero-orb-1 pointer-events-none absolute" aria-hidden="true" />
  <div class="hero-orb-2 pointer-events-none absolute" aria-hidden="true" />
  <div class="hero-orb-3 pointer-events-none absolute" aria-hidden="true" />

  <!-- Dot grid -->
  <div class="hero-dots pointer-events-none absolute inset-0" aria-hidden="true" />

  <!-- Mouse-tracking spotlight -->
  <div class="hero-spotlight pointer-events-none absolute" aria-hidden="true" />

  <!-- Edge vignettes — burn the grid into the background at all four sides -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-48"
    style="background: linear-gradient(to bottom, hsl(var(--background)), transparent);"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-48"
    style="background: linear-gradient(to top, hsl(var(--background)), transparent);"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute inset-y-0 left-0 w-48"
    style="background: linear-gradient(to right, hsl(var(--background)), transparent);"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute inset-y-0 right-0 w-48"
    style="background: linear-gradient(to left, hsl(var(--background)), transparent);"
    aria-hidden="true"
  />

  <!-- Content -->
  <div id="hero-content" class="relative z-10 flex flex-col items-center gap-8 text-center">
    <!-- Status badge (shadcn Badge variant) -->
    <span
      class={`hero-badge ${badgeVariants({ variant: 'outline' })} gap-2 border-white/[0.12] bg-white/[0.03] px-4 py-1.5 text-white/50 backdrop-blur-sm`}
    >
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      Available · 2026
    </span>

    <!-- Headline with per-word clip reveal -->
    <h1
      class="hero-heading text-balance font-black leading-[0.92] tracking-tighter text-foreground"
      style="font-size: clamp(3rem, 9.5vw, 7.5rem);"
    >
      {
        words.map((word) => (
          <span class="hero-word-wrap inline-block overflow-hidden pb-[0.1em]">
            <span class="hero-word inline-block">
              {word}&nbsp;
            </span>
          </span>
        ))
      }
    </h1>

    <!-- Thin rule -->
    <div class="hero-rule h-px w-20 bg-gradient-to-r from-transparent via-white/30 to-transparent" />

    <!-- Terminal command palette trigger -->
    <button
      type="button"
      id="hero-terminal-trigger"
      class="hero-trigger font-mono"
      aria-label="Open terminal command palette (Ctrl+K)"
    >
      <span class="hero-trigger-shell">
        <span class="hero-prompt text-white/40">&gt;</span><span class="hero-type-1 text-white/40"></span><span class="hero-type-2 text-white/65"></span><span class="hero-type-3 text-white/40"></span><span class="hero-cursor text-white/50">_</span>
      </span>
    </button>
  </div>

  <!-- Scroll indicator -->
  <div
    class="hero-indicator absolute bottom-10 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3"
    aria-hidden="true"
  >
    <span class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/20">scroll</span>
    <div class="hero-scroll-line h-10 w-px origin-top bg-white/20" />
  </div>
</section>

<style>
  /* ── Orbs ─────────────────────────────────────────────────── */
  .hero-orb-1 {
    width: clamp(400px, 65vw, 900px);
    height: clamp(400px, 65vw, 900px);
    top: -15%;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 255, 0.13) 0%,
      rgba(255, 255, 255, 0.04) 45%,
      transparent 100%
    );
    filter: blur(48px);
    animation: orb-float-1 14s ease-in-out infinite;
  }

  .hero-orb-2 {
    width: clamp(260px, 40vw, 560px);
    height: clamp(260px, 40vw, 560px);
    bottom: 5%;
    right: 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 255, 0.09) 0%,
      transparent 100%
    );
    filter: blur(64px);
    animation: orb-float-2 18s ease-in-out infinite;
  }

  .hero-orb-3 {
    width: clamp(200px, 30vw, 400px);
    height: clamp(200px, 30vw, 400px);
    top: 30%;
    left: -5%;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 255, 0.06) 0%,
      transparent 100%
    );
    filter: blur(72px);
    animation: orb-float-3 20s ease-in-out infinite;
  }

  @keyframes orb-float-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    30%       { transform: translate(28px, -22px) scale(1.05); }
    65%       { transform: translate(-20px, 16px) scale(0.97); }
  }
  @keyframes orb-float-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    40%       { transform: translate(-24px, 20px) scale(1.06); }
    75%       { transform: translate(16px, -12px) scale(0.95); }
  }
  @keyframes orb-float-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    35%       { transform: translate(18px, 14px) scale(1.04); }
    70%       { transform: translate(-12px, -18px) scale(0.98); }
  }

  /* ── Dot grid ─────────────────────────────────────────────── */
  .hero-dots {
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.22) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
  }

  /* ── Mouse spotlight ──────────────────────────────────────── */
  .hero-spotlight {
    width: 800px;
    height: 800px;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 255, 0.065) 0%,
      transparent 100%
    );
    /* Centered initially; GSAP moves it */
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  /* ── Entry animation initial states ──────────────────────── */
  .hero-badge {
    opacity: 0;
    transform: translateY(14px);
  }
  .hero-word {
    transform: translateY(110%);
    opacity: 0;
  }
  .hero-rule {
    opacity: 0;
    transform: scaleX(0);
    transform-origin: center;
  }
  .hero-trigger {
    opacity: 0;
    transform: translateY(10px);
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    white-space: nowrap;
    padding: 0.55rem 1.15rem;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.45);
    font-size: clamp(0.75rem, 1.9vw, 0.8125rem);
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: box-shadow 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
    backdrop-filter: blur(6px);
    text-align: left;
  }
  .hero-trigger-shell {
    display: inline-flex;
    align-items: center;
    min-width: max-content;
  }
  .hero-prompt {
    margin-right: 0.46rem;
  }
  .hero-type-1:not(:empty) {
    margin-right: 0.34rem;
  }
  .hero-trigger:hover {
    border-color: rgba(255, 255, 255, 0.18);
    box-shadow:
      0 0 20px rgba(255, 255, 255, 0.07),
      0 0 40px rgba(255, 255, 255, 0.03),
      inset 0 0 0 1px rgba(255, 255, 255, 0.03);
  }
  .hero-type-2 {
    letter-spacing: -0.015em;
  }
  .hero-type-2:not(:empty) {
    margin-right: 0.34rem;
  }
  .hero-type-3:not(:empty) {
    margin-left: 0;
  }
  .hero-cursor {
    margin-left: 0.16rem;
    animation: cursor-blink 1.1s step-end infinite;
  }
  @keyframes cursor-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
  .hero-indicator {
    opacity: 0;
  }
  .hero-scroll-line {
    transform: scaleY(0);
    transform-origin: top;
  }

  @media (max-width: 430px) {
    .hero-trigger {
      padding: 0.5rem 0.9rem;
      font-size: 0.75rem;
      letter-spacing: 0;
    }
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-orb-1, .hero-orb-2, .hero-orb-3 { animation: none; }
    .hero-badge, .hero-word, .hero-rule,
    .hero-trigger, .hero-indicator, .hero-scroll-line {
      opacity: 1 !important;
      transform: none !important;
    }
    .hero-cursor { animation: none; }
    #hero-content { transform: none !important; }
    .hero-type-1::before { content: 'press '; }
    .hero-type-2::before { content: '[Ctrl + K]'; }
    .hero-type-3::before { content: ' to launch terminal'; }
  }
</style>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const hero = document.getElementById('hero')!
  const spotlight = hero.querySelector<HTMLElement>('.hero-spotlight')!
  const badge = hero.querySelector<HTMLElement>('.hero-badge')!
  const heading = hero.querySelector<HTMLElement>('.hero-heading')!
  const words = hero.querySelectorAll<HTMLElement>('.hero-word')
  const rule = hero.querySelector<HTMLElement>('.hero-rule')!
  const trigger = hero.querySelector<HTMLElement>('.hero-trigger')!
  const indicator = hero.querySelector<HTMLElement>('.hero-indicator')!
  const scrollLine = hero.querySelector<HTMLElement>('.hero-scroll-line')!
  const content = document.getElementById('hero-content')!
  const orb1 = hero.querySelector<HTMLElement>('.hero-orb-1')!
  const orb2 = hero.querySelector<HTMLElement>('.hero-orb-2')!
  const orb3 = hero.querySelector<HTMLElement>('.hero-orb-3')!
  const dots = hero.querySelector<HTMLElement>('.hero-dots')!
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const triggerParts = [
    { el: hero.querySelector<HTMLElement>('.hero-type-1')!, text: 'press' },
    { el: hero.querySelector<HTMLElement>('.hero-type-2')!, text: '[Ctrl + K]' },
    { el: hero.querySelector<HTMLElement>('.hero-type-3')!, text: 'to launch terminal' },
  ]

  // ── Mouse-tracking spotlight + 3D content tilt ────────────
  hero.addEventListener('mousemove', (e) => {
    const rect = hero.getBoundingClientRect()
    const cx = rect.width / 2
    const cy = rect.height / 2
    const dx = (e.clientX - rect.left - cx) / cx
    const dy = (e.clientY - rect.top - cy) / cy

    gsap.to(spotlight, {
      left: e.clientX - rect.left,
      top: e.clientY - rect.top,
      duration: 0.75,
      ease: 'power2.out',
      overwrite: 'auto',
    })

    gsap.to(content, {
      rotateX: dy * -4,
      rotateY: dx * 4,
      transformPerspective: 1200,
      duration: 0.9,
      ease: 'power2.out',
      overwrite: 'auto',
    })

    // Subtle orb drift with mouse
    gsap.to(orb1, { x: dx * 18, y: dy * 12, duration: 1.2, ease: 'power2.out', overwrite: 'auto' })
    gsap.to(orb2, { x: dx * -22, y: dy * 16, duration: 1.4, ease: 'power2.out', overwrite: 'auto' })
    gsap.to(orb3, { x: dx * 14, y: dy * -20, duration: 1.6, ease: 'power2.out', overwrite: 'auto' })
  })

  hero.addEventListener('mouseleave', () => {
    gsap.to(content, { rotateX: 0, rotateY: 0, duration: 1.2, ease: 'power3.out', overwrite: 'auto' })
    gsap.to([orb1, orb2, orb3], { x: 0, y: 0, duration: 1.4, ease: 'power3.out', overwrite: 'auto' })
  })

  // Terminal trigger click → dispatch shared event
  trigger.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-terminal'))
  })

  function setTriggerText(charCount: number) {
    let remaining = charCount
    for (const part of triggerParts) {
      const chunk = Math.min(remaining, part.text.length)
      part.el.textContent = part.text.slice(0, chunk)
      remaining -= chunk
    }
  }

  function measureTriggerWidths() {
    triggerParts.forEach((part) => {
      part.el.textContent = part.text
    })

    const fullWidth = Math.ceil(trigger.scrollWidth)
    const collapsedWidth = Math.ceil(Math.max(trigger.offsetHeight + 6, 40))

    setTriggerText(0)

    return { fullWidth, collapsedWidth }
  }

  // ── Typewriter loop for terminal trigger ───────────────────
  function startTypewriter() {
    const totalChars = triggerParts.reduce((sum, part) => sum + part.text.length, 0)

    function scheduleType(charIndex: number) {
      if (charIndex > totalChars) {
        gsap.delayedCall(2.2, () => scheduleDelete(totalChars))
        return
      }
      setTriggerText(charIndex)

      const progress = charIndex / totalChars
      const eased = 0.5 - 0.5 * Math.cos(Math.PI * progress)
      const baseDelay = 82 - eased * 54
      const jitter = (Math.random() - 0.5) * 32

      gsap.delayedCall((baseDelay + jitter) / 1000, () => scheduleType(charIndex + 1))
    }

    function scheduleDelete(charIndex: number) {
      if (charIndex < 0) {
        gsap.delayedCall(0.55, () => scheduleType(0))
        return
      }
      setTriggerText(charIndex)

      const progress = charIndex / totalChars
      const eased = Math.pow(progress, 0.45)
      const baseDelay = 22 + (1 - eased) * 68
      const jitter = (Math.random() - 0.5) * 20

      gsap.delayedCall((baseDelay + jitter) / 1000, () => scheduleDelete(charIndex - 1))
    }

    scheduleType(0)
  }

  // ── Entry animation, sequenced after the global boot overlay ─────────────
  let heroEntranceStarted = false

  function startHeroEntrance() {
    if (heroEntranceStarted || reduceMotion) return
    heroEntranceStarted = true
    const { fullWidth, collapsedWidth } = measureTriggerWidths()
    const triggerStyles = window.getComputedStyle(trigger)
    const expandedPaddingLeft = Number.parseFloat(triggerStyles.paddingLeft)
    const expandedPaddingRight = Number.parseFloat(triggerStyles.paddingRight)

    gsap
      .timeline({ defaults: { ease: 'power3.out' } })
      .to(badge, { opacity: 1, y: 0, duration: 0.7, delay: 0.08 })
      .to(words, { opacity: 1, y: 0, duration: 0.8, stagger: 0.055 }, '-=0.35')
      .to(rule, { opacity: 1, scaleX: 1, duration: 0.7, ease: 'power2.inOut' }, '-=0.4')
      .fromTo(
        trigger,
        {
          opacity: 0,
          y: 10,
          width: collapsedWidth,
          paddingLeft: 12,
          paddingRight: 12,
        },
        {
          opacity: 1,
          y: 0,
          width: fullWidth,
          paddingLeft: expandedPaddingLeft,
          paddingRight: expandedPaddingRight,
          duration: 0.72,
          ease: 'expo.out',
          onComplete: startTypewriter,
        },
        '-=0.3',
      )
      .to(indicator, { opacity: 1, duration: 0.5 }, '-=0.3')
      .to(scrollLine, { scaleY: 1, duration: 1, ease: 'power2.inOut' }, '<')
  }

  if (document.documentElement.dataset.siteReady === 'true') {
    startHeroEntrance()
  } else {
    window.addEventListener('site-ready', startHeroEntrance, { once: true })
    window.setTimeout(startHeroEntrance, 2300)
  }

  // ── Pinned scroll exit ────────────────────────────────────
  if (!reduceMotion) {
    gsap
      .timeline({
        defaults: { ease: 'none' },
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: '+=120%',
          scrub: true,
          pin: true,
          anticipatePin: 1,
        },
      })
      .to(content, { yPercent: -34, scale: 0.94 }, 0)
      .to([badge, heading], { filter: 'blur(1.5px)' }, 0)
      .to(words, { yPercent: -18, stagger: 0.02 }, 0)
      .to(rule, { scaleX: 0.72 }, 0)
      .to(trigger, { yPercent: -16 }, 0)
      .to(indicator, { yPercent: -90 }, 0)
      .to(dots, { yPercent: -26, opacity: 0.25 }, 0)
      .to(orb1, { yPercent: -34, scale: 1.08, opacity: 0.4 }, 0)
      .to(orb2, { yPercent: -62, scale: 0.92, opacity: 0.35 }, 0)
      .to(orb3, { yPercent: -78, scale: 1.16, opacity: 0.28 }, 0)
  }
</script>
