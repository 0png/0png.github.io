---
import { Button } from '@/components/ui/button'

interface Props {
  githubUrl: string
  year: number
}

const { githubUrl, year } = Astro.props
---

<footer
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 py-24"
>
  <!-- Perspective grid floor -->
  <div class="footer-grid pointer-events-none absolute inset-0" aria-hidden="true" />

  <!-- Central beam from below -->
  <div class="footer-beam pointer-events-none absolute" aria-hidden="true" />

  <!-- Top fade — blends into preceding section -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-48"
    style="background: linear-gradient(to bottom, hsl(var(--background)), transparent);"
    aria-hidden="true"
  />

  <!-- Vignette edges -->
  <div class="footer-vignette pointer-events-none absolute inset-0" aria-hidden="true" />

  <!-- Background orb -->
  <div class="footer-orb pointer-events-none absolute" aria-hidden="true" />

  <!-- Large display typography -->
  <div class="relative z-10 flex flex-col items-center gap-12 text-center">
    <p
      class="select-none font-black uppercase leading-none tracking-tighter text-foreground/[0.06]"
      style="font-size: clamp(3rem, 16vw, 14rem);"
      aria-hidden="true"
    >
      DESIGNED<br />BY 0PNG
    </p>

    <!-- Visible heading for accessibility -->
    <h2 class="sr-only">Footer — Designed by 0PNG</h2>

    <!-- GitHub CTA -->
    <Button
      asChild
      variant="outline"
      class="border-white/10 bg-white/[0.03] text-white/60 backdrop-blur-sm transition-colors hover:border-white/20 hover:bg-white/[0.06] hover:text-white/90"
    >
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-8 py-3 font-mono text-sm uppercase tracking-widest"
      >
        <!-- GitHub icon (inline SVG) -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
        View on GitHub
      </a>
    </Button>

    <!-- Copyright -->
    <p class="font-mono text-xs uppercase tracking-widest text-white/20">
      © {year} 0PNG. ALL RIGHTS RESERVED.
    </p>
  </div>
</footer>

<style>
  /* ── Perspective grid ─────────────────────────────────────── */
  .footer-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 60px 60px;
    transform: perspective(600px) rotateX(60deg) scaleY(2.2);
    transform-origin: center bottom;
    bottom: 0;
    top: -60%;
    mask-image: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
    -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
    animation: grid-drift 12s linear infinite;
  }

  @keyframes grid-drift {
    from { background-position: 0 0; }
    to   { background-position: 0 60px; }
  }

  /* ── Central beam ─────────────────────────────────────────── */
  .footer-beam {
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: clamp(200px, 40vw, 500px);
    height: 75%;
    background: conic-gradient(
      from 270deg at 50% 100%,
      transparent 30deg,
      rgba(255, 255, 255, 0.07) 90deg,
      transparent 150deg
    );
    animation: beam-pulse 4s ease-in-out infinite;
  }

  @keyframes beam-pulse {
    0%, 100% { opacity: 0.6; }
    50%       { opacity: 1; }
  }

  /* ── Radial vignette ──────────────────────────────────────── */
  .footer-vignette {
    background: radial-gradient(
      ellipse 80% 60% at 50% 100%,
      transparent 0%,
      hsl(var(--background) / 0.6) 70%,
      hsl(var(--background)) 100%
    );
  }

  /* ── Orb ──────────────────────────────────────────────────── */
  .footer-orb {
    width: clamp(400px, 70vw, 900px);
    height: clamp(400px, 70vw, 900px);
    bottom: -20%;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 45%,
      transparent 100%
    );
    filter: blur(72px);
  }

  /* ── Reduced motion ───────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .footer-grid { animation: none; }
    .footer-beam { animation: none; }
  }
</style>
