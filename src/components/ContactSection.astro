---
import ContactDashboard from '@/components/ContactDashboard'
import { contactConfig } from '@/data/contactConfig'
import rawActivityLog from '@/data/github-stats.json'
import type { ActivityLogEntry } from '@/components/ContactDashboard'

const activityLog = rawActivityLog as ActivityLogEntry[]
---

<section
  id="contact"
  class="relative overflow-hidden px-6 py-20 md:px-8 md:py-28"
  aria-label="Contact"
>
  <div class="relative z-10 mx-auto max-w-5xl">

    <!-- Section header — mirrors Changelog structure -->
    <div class="contact-header mb-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.35em] text-white/20">
        cat ~/.config/identity.json
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl">CONTACT</h2>
    </div>

    <!-- List (React island) -->
    <div
      id="contact-list"
      class="contact-grid rounded-sm border border-white/[0.06] bg-neutral-950/55 backdrop-blur-sm"
    >
      <ContactDashboard
        activityLog={activityLog}
        discord={contactConfig.discord}
        email={contactConfig.email}
        githubUrl={contactConfig.githubUrl}
        github={contactConfig.github}
        client:visible
      />
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap'
  import ScrollTrigger from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  gsap.fromTo(
    '.contact-header > *',
    { autoAlpha: 0, y: 18 },
    {
      autoAlpha: 1,
      y: 0,
      stagger: 0.1,
      duration: 0.65,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#contact', start: 'top 85%' },
    },
  )

  gsap.fromTo(
    '.contact-grid',
    { autoAlpha: 0, y: 22 },
    {
      autoAlpha: 1,
      y: 0,
      duration: 0.65,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#contact', start: 'top 80%' },
    },
  )
</script>
