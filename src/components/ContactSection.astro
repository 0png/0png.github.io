---
import ContactDashboard from '@/components/ContactDashboard'
import { contactConfig } from '@/data/contactConfig'
import rawActivityLog from '@/data/github-stats.json'
import type { ActivityLogEntry } from '@/components/ContactDashboard'

const activityLog = rawActivityLog as ActivityLogEntry[]
---

<section
  id="contact"
  class="relative overflow-hidden px-6 py-20 md:px-8 md:py-28"
  aria-label="Contact"
>
  <!-- Floating background orb — moves with scroll parallax -->
  <div
    class="contact-bg-orb pointer-events-none absolute"
    aria-hidden="true"
    style="
      width: clamp(300px, 50vw, 600px);
      height: clamp(300px, 50vw, 600px);
      top: -10%;
      left: -5%;
      border-radius: 50%;
      background: radial-gradient(circle closest-side, rgba(255,255,255,0.06) 0%, transparent 100%);
      filter: blur(80px);
    "
  />

  <div class="relative z-10 mx-auto max-w-5xl">

    <!-- Section header — mirrors Changelog structure -->
    <div class="contact-header mb-16">
      <p class="font-mono text-[11px] uppercase tracking-[0.35em] text-white/20">
        cat ~/.config/identity.json
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground md:text-4xl">CONTACT</h2>
    </div>

    <!-- List (React island) -->
    <div
      id="contact-list"
      class="contact-grid rounded-sm border border-white/[0.06] bg-neutral-950/55 backdrop-blur-sm"
    >
      <ContactDashboard
        activityLog={activityLog}
        discord={contactConfig.discord}
        email={contactConfig.email}
        client:visible
      />
    </div>

  </div>
</section>

<script>
  import gsap from 'gsap'
  import ScrollTrigger from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const section = document.getElementById('contact')!

  // Background orb parallax — rises as you scroll into the section
  gsap.to('.contact-bg-orb', {
    yPercent: -35,
    ease: 'none',
    scrollTrigger: {
      trigger: section,
      start: 'top bottom',
      end: 'bottom top',
      scrub: 1.5,
    },
  })

  // Header text floats up slightly faster than content
  gsap.fromTo(
    '.contact-header > *',
    { autoAlpha: 0, y: 18 },
    {
      autoAlpha: 1,
      y: 0,
      stagger: 0.1,
      duration: 0.65,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#contact', start: 'top 85%' },
    },
  )

  gsap.fromTo(
    '.contact-grid',
    { autoAlpha: 0, y: 22 },
    {
      autoAlpha: 1,
      y: 0,
      duration: 0.65,
      ease: 'power3.out',
      scrollTrigger: { trigger: '#contact', start: 'top 80%' },
    },
  )

  // Subtle scroll-depth float on the contact grid
  gsap.to('.contact-grid', {
    yPercent: -5,
    ease: 'none',
    scrollTrigger: {
      trigger: section,
      start: 'top bottom',
      end: 'bottom top',
      scrub: 2.5,
    },
  })

  // Header parallax — drifts slightly faster than grid (depth separation)
  gsap.to('.contact-header', {
    yPercent: -8,
    ease: 'none',
    scrollTrigger: {
      trigger: section,
      start: 'top bottom',
      end: 'bottom top',
      scrub: 1.8,
    },
  })
</script>
