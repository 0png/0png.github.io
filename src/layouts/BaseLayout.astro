---
import '@/styles/global.css'
import Navbar from '@/components/Navbar.astro'
import TerminalPalette from '@/components/TerminalPalette'

interface Props {
  title: string
  description?: string
  image?: string
  showBoot?: boolean
}

const { title, description, showBoot = false } = Astro.props
const image = Astro.props.image ?? '/og-image.png'
const canonicalUrl = Astro.url.href
const siteUrl = Astro.site?.origin ?? 'https://0png.github.io'
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`
const resetHomeScrollOnLoad = Astro.url.pathname === '/'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="0PNG" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <style>
      #site-boot {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: hsl(var(--background));
        color: rgb(229 229 229);
      }
      #site-boot::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: radial-gradient(circle at center, black, transparent 72%);
      }
      #site-boot::after {
        content: '';
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 3px,
          rgba(255, 255, 255, 0.025) 4px
        );
        pointer-events: none;
      }
      .boot-panel {
        position: relative;
        z-index: 1;
        width: min(560px, 100%);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 0.5rem;
        background: rgb(10 10 10);
        box-shadow:
          0 24px 80px rgba(0, 0, 0, 0.62),
          inset 0 1px 0 rgba(255, 255, 255, 0.04);
        font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
        overflow: hidden;
      }
      .boot-chrome {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        background: rgba(0, 0, 0, 0.8);
        padding: 0.8rem 1rem;
        color: rgb(255 255 255 / 42%);
        font-size: 0.68rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
      .boot-dot {
        width: 0.75rem;
        height: 0.75rem;
        flex-shrink: 0;
        border-radius: 9999px;
      }
      .boot-dot-red {
        background: #ff5f57;
      }
      .boot-dot-yellow {
        background: #febc2e;
      }
      .boot-dot-green {
        background: #28c840;
      }
      .boot-title {
        margin-left: 0.75rem;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .boot-lines {
        display: grid;
        gap: 0.6rem;
        padding: 1.2rem 1.25rem 1rem;
        font-size: clamp(0.72rem, 1.8vw, 0.86rem);
        line-height: 1.55;
      }
      .boot-line {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        color: rgb(255 255 255 / 52%);
        opacity: 0;
        transform: translateY(8px);
      }
      .boot-line span:first-child {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .boot-ok {
        flex-shrink: 0;
        color: rgb(255 255 255 / 28%);
      }
      .boot-progress {
        height: 1px;
        margin: 0 1.25rem 1.1rem;
        transform: scaleX(0);
        transform-origin: left;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.72), rgba(251, 191, 36, 0.38), transparent);
        box-shadow: 0 0 18px rgba(255, 255, 255, 0.08);
      }
      .boot-reduced #site-boot,
      #site-boot.boot-complete {
        pointer-events: none;
      }
      #mobile-notice {
        position: fixed;
        bottom: 1rem;
        left: 50%;
        translate: -50% 0;
        z-index: 9999;
        font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
        font-size: 0.75rem;
        line-height: 1.4;
        color: rgb(251 191 36);
        background: rgba(0, 0, 0, 0.82);
        border: 1px solid rgba(251, 191, 36, 0.25);
        border-radius: 4px;
        padding: 0.45rem 0.6rem 0.45rem 0.85rem;
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        max-width: calc(100vw - 2rem);
        box-sizing: border-box;
      }
      .mobile-notice-text {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        min-width: 0;
      }
      .mobile-notice-prefix {
        color: rgb(251 191 36 / 60%);
        margin-right: 0.35em;
        flex-shrink: 0;
      }
      #mobile-notice-close {
        flex-shrink: 0;
        background: none;
        border: none;
        color: rgb(251 191 36 / 50%);
        cursor: pointer;
        font-family: inherit;
        font-size: 0.75rem;
        padding: 0 0.1rem;
        line-height: 1;
        transition: color 0.15s;
      }
      #mobile-notice-close:hover {
        color: rgb(251 191 36);
      }
      @media (prefers-reduced-motion: reduce) {
        #site-boot {
          display: none;
        }
      }
    </style>
  </head>
  <body data-reset-home-scroll-on-load={resetHomeScrollOnLoad ? 'true' : 'false'}>
    {
      showBoot && (
        <div id="site-boot" class="terminal-palette" aria-live="polite" aria-label="Loading 0PNG">
          <div class="boot-panel bg-neutral-950">
            <div class="boot-chrome">
              <span class="boot-dot boot-dot-red" aria-hidden="true" />
              <span class="boot-dot boot-dot-yellow" aria-hidden="true" />
              <span class="boot-dot boot-dot-green" aria-hidden="true" />
              <span class="boot-title">~/0png — boot</span>
              <span class="ml-auto text-white/20">init</span>
            </div>
            <div class="boot-lines">
              <div class="boot-line">
                <span>
                  <span class="text-white/25">$</span> boot 0PNG.dev
                </span>
                <span class="boot-ok">done</span>
              </div>
              <div class="boot-line">
                <span>
                  <span class="text-white/25">$</span> mount /about /projects /changelog
                </span>
                <span class="boot-ok">done</span>
              </div>
              <div class="boot-line">
                <span>
                  <span class="text-white/25">$</span> read github_activity.cache
                </span>
                <span class="boot-ok">done</span>
              </div>
              <div class="boot-line">
                <span>
                  <span class="text-white/25">$</span> launch interface
                </span>
                <span class="boot-ok">ready</span>
              </div>
            </div>
            <div class="boot-progress" aria-hidden="true" />
          </div>
        </div>
      )
    }

    <!-- Mobile notice — hidden by default, revealed by JS on touch devices -->
    <div id="mobile-notice" aria-live="polite" hidden>
      <span class="mobile-notice-text">
        <span class="mobile-notice-prefix">[&nbsp;NOTICE&nbsp;]:</span>
        Best experienced on desktop.
      </span>
      <button type="button" id="mobile-notice-close" aria-label="Dismiss notice">✕</button>
    </div>

    <Navbar />
    <slot />
    <TerminalPalette client:load />
    <script>
      import gsap from 'gsap'

      const boot = document.getElementById('site-boot')
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function markReady() {
        window.dispatchEvent(new Event('site-ready'))
        document.documentElement.dataset.siteReady = 'true'
        document.body.style.overflow = ''
      }

      if (!boot || reduceMotion) {
        markReady()
      } else {
        document.body.style.overflow = 'hidden'
        const lines = boot.querySelectorAll<HTMLElement>('.boot-line')
        const progress = boot.querySelector<HTMLElement>('.boot-progress')

        gsap
          .timeline({
            defaults: { ease: 'power3.out' },
            onComplete: () => {
              boot.classList.add('boot-complete')
              markReady()
            },
          })
          .to(lines, { opacity: 1, y: 0, duration: 0.28, stagger: 0.16 })
          .to(progress, { scaleX: 1, duration: 0.62, ease: 'power2.inOut' }, 0.12)
          .to(boot, { opacity: 0, duration: 0.42, ease: 'power2.inOut' }, '+=0.15')
          .set(boot, { display: 'none' })
      }
    </script>
    <script>
      import { initScroll } from '@/lib/scroll'
      const resetHomeScrollOnLoad = document.body.dataset.resetHomeScrollOnLoad === 'true'
      initScroll({ resetToTopOnLoad: resetHomeScrollOnLoad })
    </script>
    <script>
      const isMobile = navigator.maxTouchPoints > 0 && window.innerWidth < 1024
      if (isMobile) {
        const el = document.getElementById('mobile-notice')
        if (el) el.hidden = false
      }
      document.getElementById('mobile-notice-close')?.addEventListener('click', () => {
        const el = document.getElementById('mobile-notice')
        if (el) el.hidden = true
      })
    </script>
  </body>
</html>
