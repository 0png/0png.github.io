---
import { marked } from 'marked'
import BlogLayout from '@/layouts/BlogLayout.astro'
import { getAllDevlogs, getDevlogBySlug, transformNotionPage } from '@/lib/notion'
import type { PageObjectResponse } from '@notionhq/client'

export async function getStaticPaths() {
  try {
    const pages = await getAllDevlogs()
    return pages
      .map((page) => {
        const entry = transformNotionPage(page as PageObjectResponse)
        if (!entry) return null
        return {
          params: { slug: entry.slug },
          props: { pageId: page.id },
        }
      })
      .filter((p): p is NonNullable<typeof p> => p !== null)
  } catch (err) {
    console.warn('[blog] Notion unavailable — skipping blog route generation:', err)
    return []
  }
}

const { slug } = Astro.params
const { markdown, page } = await getDevlogBySlug(slug)
const entry = transformNotionPage(page as PageObjectResponse)

const htmlContent = await marked(markdown)
---

<BlogLayout
  title={entry?.title ?? slug}
  date={entry?.date ?? ''}
  projectId={entry?.projectId ?? ''}
>
  <Fragment set:html={htmlContent} />
</BlogLayout>
