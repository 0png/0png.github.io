---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Footer from '@/components/Footer.astro'
import { projects } from '@/data/projects'
import { siteConfig } from '@/data/siteConfig'

const allProjects = [...projects].sort((a, b) => a.order - b.order)
const featuredProjects = allProjects.filter((project) => project.featured)
const allTags = [...new Set(allProjects.flatMap((project) => project.tags))].sort()
const latestYear = Math.max(...allProjects.map((project) => project.year))
---

<BaseLayout title={`Projects — ${siteConfig.name}`} description="All projects">
  <main class="projects-command-page">
    <div class="projects-atmosphere" aria-hidden="true">
      <div class="projects-grid-plane" data-projects-layer data-speed="-0.04"></div>
      <div class="projects-depth-line projects-depth-line-a" data-projects-layer data-speed="0.08"></div>
      <div class="projects-depth-line projects-depth-line-b" data-projects-layer data-speed="-0.06"></div>
    </div>

    <section class="projects-hero-stage" aria-labelledby="projects-title">
      <a href="/" class="projects-back-link" data-projects-reveal>
        <span aria-hidden="true">&lt;</span>
        ~/home
      </a>

      <div class="projects-hero-panel" data-projects-reveal>
        <div class="projects-panel-line" aria-hidden="true"></div>
        <div class="projects-hero-grid">
          <div class="projects-hero-copy">
            <div class="projects-command-line">
              <span class="text-dim">$</span>
              <span>ls --depth --interactive ./projects</span>
              <span class="command-head">STACK@{String(allProjects.length).padStart(2, '0')}</span>
            </div>

            <p class="projects-kicker">/usr/local/portfolio.project-stack</p>

            <h1 id="projects-title" class="projects-title">PROJECTS</h1>

            <p class="projects-lede">
              A deep stack of shipped tools, launchers, solvers, and interface
              experiments. Scroll through each build panel like a scrubbed
              terminal reel, then jump into the devlog behind the project.
            </p>
          </div>

          <div class="projects-stat-panel" aria-label="Project page stats">
            <div class="projects-stat-grid">
              <div>
                <p>builds</p>
                <strong>{allProjects.length}</strong>
              </div>
              <div>
                <p>featured</p>
                <strong>{featuredProjects.length}</strong>
              </div>
            </div>
            <div class="projects-stat-wide">
              <p>latest deploy</p>
              <strong>{latestYear}</strong>
            </div>
            <div class="projects-stat-wide">
              <p>visible</p>
              <strong data-project-count>{allProjects.length}</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="projects-filter-bar" data-projects-reveal aria-label="Filter projects by tag">
        <button type="button" class="filter-chip is-active" data-project-filter="all">All Builds</button>
        {
          allTags.map((tag) => (
            <button type="button" class="filter-chip" data-project-filter={tag}>
              {tag}
            </button>
          ))
        }
      </div>
    </section>

    <section class="projects-stack-stage" aria-label="Project stack">
      <div class="projects-stack-track">
        {
          allProjects.map((project, index) => (
            <article
              id={project.id}
              class={`project-stack-card ${index % 2 === 1 ? 'is-reversed' : ''}`}
              data-project-card
              data-projects-reveal
              data-project-depth
              data-project-tags={project.tags.join('|')}
              style={`--project-index: ${index}; --stack-side: ${index % 2 === 1 ? -1 : 1};`}
            >
              <div class="project-stack-lock" data-project-lock>
                <div class="project-panel">
                  <div class="project-panel-media" data-project-media>
                    {
                      project.coverImage ? (
                        <img src={project.coverImage} alt={`Cover image for ${project.title}`} />
                      ) : (
                        <div class="project-generated-visual" aria-hidden="true">
                          <span>{String(index + 1).padStart(2, '0')}</span>
                          <strong>{project.year}</strong>
                        </div>
                      )
                    }
                    <div class="project-panel-scan" aria-hidden="true"></div>
                  </div>

                  <div class="project-panel-copy">
                    <div class="project-panel-meta">
                      <span>build {String(index + 1).padStart(2, '0')}</span>
                      <span>{project.year}</span>
                    </div>

                    <h2>{project.title}</h2>
                    <p>{project.excerpt}</p>

                    <div class="project-tag-row" aria-label={`${project.title} tags`}>
                      {
                        project.tags.map((tag) => (
                          <span>{tag}</span>
                        ))
                      }
                    </div>
                  </div>
                </div>

                <div class="project-node-callout" data-project-callout>
                  <div class="project-node-dot" aria-hidden="true"></div>
                  <div class="project-callout-line" aria-hidden="true"></div>
                  <div class="project-callout-copy">
                    <p>{project.description}</p>
                    {
                      project.devlogSlug !== null && (
                        <a href={`/projects/${project.devlogSlug}`} class="project-devlog-link">
                          Read Devlog
                          <span aria-hidden="true">-&gt;</span>
                        </a>
                      )
                    }
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <Footer githubUrl={siteConfig.githubUrl} year={siteConfig.year} />
</BaseLayout>

<style>
  .projects-command-page {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: clip;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent 12rem),
      linear-gradient(180deg, hsl(var(--background)) 0%, rgba(9, 12, 10, 0.98) 48%, hsl(var(--background)) 100%);
  }

  .projects-atmosphere {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .projects-grid-plane {
    position: fixed;
    inset: -30% -10% auto;
    height: 140vh;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 88px 88px;
    opacity: 0.55;
    mask-image: linear-gradient(180deg, transparent, black 18%, black 70%, transparent);
    transform: perspective(1100px) rotateX(68deg) translateY(var(--layer-y, 0));
    transform-origin: top center;
  }

  .projects-depth-line {
    position: fixed;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(143, 255, 185, 0.14), transparent);
    opacity: 0.34;
    transform: translate3d(0, var(--layer-y, 0), 0);
  }

  .projects-depth-line-a {
    left: 19vw;
  }

  .projects-depth-line-b {
    right: 17vw;
  }

  .projects-hero-stage {
    width: min(1280px, calc(100% - 3rem));
    min-height: 86vh;
    margin: 0 auto;
    display: grid;
    align-content: center;
    gap: 1.5rem;
    padding: 7rem 0 3.5rem;
  }

  .projects-back-link,
  .filter-chip,
  .project-devlog-link {
    display: inline-flex;
    align-items: center;
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
    text-transform: uppercase;
    transition:
      transform 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .projects-back-link {
    justify-self: start;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.72rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .projects-back-link span {
    transition: transform 0.2s ease;
  }

  .projects-back-link:hover span {
    transform: translateX(-0.25rem);
  }

  .projects-back-link:hover,
  .project-devlog-link:hover {
    color: rgb(252, 211, 77);
  }

  .projects-hero-panel {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 10, 10, 0.62);
    backdrop-filter: blur(14px);
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.24);
  }

  .projects-panel-line {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  }

  .projects-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(290px, 0.85fr);
    gap: 2rem;
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .projects-command-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding-bottom: 1rem;
    color: rgba(255, 255, 255, 0.35);
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
    font-size: 0.7rem;
  }

  .text-dim {
    color: rgba(255, 255, 255, 0.2);
  }

  .command-head {
    margin-left: auto;
    color: rgba(52, 211, 153, 0.72);
  }

  .projects-kicker {
    margin: 1.45rem 0 0;
    color: rgba(252, 211, 77, 0.58);
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
  }

  .projects-title {
    margin: 0.75rem 0 0;
    color: rgb(250, 250, 250);
    font-size: clamp(3.6rem, 8vw, 7rem);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: 0;
  }

  .projects-lede {
    max-width: 720px;
    margin: 1.35rem 0 0;
    color: rgb(163, 163, 163);
    font-size: 1rem;
    line-height: 1.75;
  }

  .projects-stat-panel {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
    font-size: 0.72rem;
  }

  .projects-stat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .projects-stat-grid > div,
  .projects-stat-wide {
    border: 1px solid rgba(255, 255, 255, 0.07);
    background: rgba(0, 0, 0, 0.35);
    padding: 1rem;
  }

  .projects-stat-panel p {
    margin: 0;
    color: rgba(255, 255, 255, 0.25);
    text-transform: lowercase;
  }

  .projects-stat-panel strong {
    display: block;
    margin-top: 0.45rem;
    color: white;
    font-size: 2rem;
    line-height: 1;
  }

  .projects-stat-wide strong {
    color: rgb(252, 211, 77);
    font-size: 1.25rem;
  }

  .projects-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(10, 10, 10, 0.68);
    padding: 0.75rem;
    backdrop-filter: blur(14px);
  }

  .filter-chip {
    cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: transparent;
    color: rgba(255, 255, 255, 0.45);
    padding: 0.56rem 0.7rem;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .filter-chip:hover,
  .filter-chip.is-active {
    color: rgb(253, 230, 138);
    border-color: rgba(252, 211, 77, 0.3);
    background: rgba(252, 211, 77, 0.09);
    transform: translateY(-1px);
  }

  .filter-chip.is-active {
    box-shadow:
      0 0 22px rgba(251, 191, 36, 0.08),
      inset 0 0 0 1px rgba(251, 191, 36, 0.08);
  }

  .projects-stack-stage {
    width: min(1220px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 0 0 9rem;
    perspective: 1400px;
  }

  .projects-stack-track {
    display: grid;
    gap: 0;
    transform-style: preserve-3d;
  }

  .project-stack-card {
    position: relative;
    min-height: 118vh;
    transform-style: preserve-3d;
    opacity: 0;
    transform: translateY(38px);
    transition:
      opacity 0.72s ease,
      transform 0.88s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity;
  }

  .project-stack-card.is-reversed {
    --lock-template: minmax(250px, 0.36fr) minmax(0, 0.78fr);
  }

  .project-stack-card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-stack-card.is-hidden {
    display: none;
  }

  .project-stack-lock {
    position: sticky;
    top: clamp(6rem, calc((100vh - 440px) / 2), 8rem);
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(250px, 0.36fr);
    gap: clamp(1.4rem, 4vw, 4rem);
    align-items: center;
    min-height: min(440px, 70vh);
    transform:
      translate3d(calc(var(--stack-side) * 7rem), 5rem, -210px)
      rotateY(calc(var(--stack-side) * -18deg))
      rotateX(7deg)
      scale(0.88);
    transform-style: preserve-3d;
    transition: transform 0.18s linear;
    will-change: transform;
  }

  .project-stack-card.is-reversed .project-stack-lock {
    grid-template-columns: minmax(250px, 0.36fr) minmax(0, 0.78fr);
  }

  .project-panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(220px, 0.92fr) minmax(260px, 0.72fr);
    min-height: min(440px, 70vh);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.018)),
      rgba(7, 7, 7, 0.82);
    box-shadow:
      0 46px 120px rgba(0, 0, 0, 0.52),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    transform-style: preserve-3d;
    z-index: 1;
  }

  .project-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 26%),
      repeating-linear-gradient(0deg, transparent, transparent 9px, rgba(255, 255, 255, 0.035) 10px);
    opacity: 0.34;
  }

  .project-panel-media {
    position: relative;
    min-height: 100%;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.015)),
      #111111;
    transform: translate3d(0, 0, 70px);
    will-change: transform;
  }

  .project-panel-media img {
    width: 100%;
    height: 100%;
    min-height: min(440px, 70vh);
    object-fit: cover;
    opacity: 0.54;
    filter: saturate(0.75) contrast(1.08);
  }

  .project-generated-visual {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    gap: 1rem;
    padding: 2rem;
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
  }

  .project-generated-visual span {
    color: rgba(255, 255, 255, 0.34);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .project-generated-visual strong {
    color: rgba(255, 255, 255, 0.09);
    font-size: clamp(6rem, 12vw, 10rem);
    line-height: 0.78;
  }

  .project-panel-scan {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(110deg, transparent 0%, rgba(255, 255, 255, 0.18) 42%, transparent 54%),
      linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.64));
    opacity: 0.24;
    transform: translateX(-42%);
    transition: transform 0.7s ease;
  }

  .project-stack-card:hover .project-panel-scan {
    transform: translateX(18%);
  }

  .project-panel-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: 1.25rem;
    padding: clamp(1.35rem, 3vw, 2rem);
    transform: translate3d(0, 0, 110px);
  }

  .project-panel-meta,
  .project-tag-row,
  .project-devlog-link {
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
    text-transform: uppercase;
  }

  .project-panel-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .project-panel-copy h2 {
    margin: 0;
    color: white;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .project-panel-copy p {
    max-width: 34rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 1rem;
    line-height: 1.72;
  }

  .project-tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .project-tag-row span {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.35rem 0.55rem;
    color: rgba(255, 255, 255, 0.54);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .project-node-callout {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(3rem, 1fr);
    align-items: center;
    gap: 0;
    z-index: 3;
    opacity: 0.24;
    transform: translate3d(0, 0, 180px) scale(0.96);
    transform-origin: center left;
    transition:
      opacity 0.42s ease,
      transform 0.54s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .project-stack-card.is-reversed .project-node-callout {
    grid-template-columns: minmax(3rem, 1fr) auto;
    transform-origin: center right;
  }

  .project-stack-card.is-reversed .project-panel {
    grid-column: 2;
  }

  .project-stack-card.is-reversed .project-node-callout {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
  }

  .project-node-dot {
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    background: rgb(74, 222, 128);
    box-shadow: 0 0 24px rgba(74, 222, 128, 0.72);
    transform: scale(0.82);
    transition: transform 0.38s ease;
  }

  .project-callout-line {
    height: 1px;
    min-width: clamp(3rem, 9vw, 7rem);
    background: linear-gradient(90deg, rgba(74, 222, 128, 0.68), rgba(255, 255, 255, 0.08));
    transform: scaleX(0.08);
    transform-origin: left center;
    transition: transform 0.46s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .project-stack-card.is-reversed .project-callout-line {
    grid-column: 1;
    grid-row: 1;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.08), rgba(74, 222, 128, 0.68));
    transform-origin: right center;
  }

  .project-stack-card.is-reversed .project-node-dot {
    grid-column: 2;
    grid-row: 1;
  }

  .project-callout-copy {
    grid-column: 1 / -1;
    margin-top: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 1rem;
    background: rgba(8, 8, 8, 0.72);
    backdrop-filter: blur(14px);
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.42s ease 0.08s,
      transform 0.46s cubic-bezier(0.22, 1, 0.36, 1) 0.08s;
  }

  .project-callout-copy p {
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.9rem;
    line-height: 1.66;
  }

  .project-devlog-link {
    gap: 0.5rem;
    margin-top: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 7px;
    background: rgba(8, 8, 8, 0.66);
    color: rgba(255, 255, 255, 0.62);
    padding: 0.65rem 0.72rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    position: relative;
    z-index: 4;
    pointer-events: auto;
  }

  .project-devlog-link:hover {
    border-color: rgba(74, 222, 128, 0.36);
    background: rgba(74, 222, 128, 0.1);
    color: white;
    transform: translateY(-2px);
  }

  .project-stack-card.is-focused .project-node-callout {
    opacity: 1;
    transform: translate3d(0, 0, 180px) scale(1);
  }

  .project-stack-card.is-focused .project-node-dot {
    transform: scale(1);
  }

  .project-stack-card.is-focused .project-callout-line {
    transform: scaleX(1);
  }

  .project-stack-card.is-focused .project-callout-copy {
    opacity: 1;
    transform: translateY(0);
  }

  [data-projects-reveal] {
    opacity: 0;
    transition:
      opacity 0.72s ease,
      transform 0.82s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-projects-reveal].is-visible {
    opacity: 1;
  }

  .projects-back-link[data-projects-reveal],
  .projects-hero-copy[data-projects-reveal],
  .projects-filter-bar[data-projects-reveal] {
    transform: translateY(28px);
  }

  .projects-back-link[data-projects-reveal].is-visible,
  .projects-hero-copy[data-projects-reveal].is-visible,
  .projects-filter-bar[data-projects-reveal].is-visible {
    transform: translateY(0);
  }

  @media (max-width: 980px) {
    .projects-stack-stage,
    .projects-hero-stage {
      width: calc(100% - 2rem);
    }

    .projects-hero-grid {
      grid-template-columns: 1fr;
    }

    .projects-command-line {
      align-items: flex-start;
    }

    .command-head {
      width: 100%;
      margin-left: 0;
    }

    .projects-kicker {
      letter-spacing: 0.22em;
    }

    .project-stack-card,
    .project-stack-card.is-reversed {
      min-height: auto;
      transform: translateY(26px);
    }

    .project-stack-card.is-visible {
      transform: translateY(0);
    }

    .project-stack-lock,
    .project-stack-card.is-reversed .project-stack-lock {
      position: relative;
      top: auto;
      grid-template-columns: 1fr;
      gap: 1rem;
      min-height: auto;
      transform: none;
    }

    .project-panel {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .project-stack-card.is-reversed .project-panel,
    .project-stack-card.is-reversed .project-node-callout {
      grid-column: auto;
      grid-row: auto;
      justify-self: stretch;
    }

    .project-panel-media,
    .project-panel-media img {
      min-height: 260px;
    }

    .project-node-callout,
    .project-stack-card.is-reversed .project-node-callout {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 0.75rem;
      transform: none;
      opacity: 1;
    }

    .project-callout-line,
    .project-stack-card.is-reversed .project-callout-line {
      width: 1px;
      min-width: 1px;
      min-height: 2.75rem;
      height: 2.75rem;
      margin-left: 0.5rem;
      background: linear-gradient(180deg, rgba(74, 222, 128, 0.68), rgba(255, 255, 255, 0.08));
      transform: scaleY(1);
      transform-origin: top center;
    }

    .project-callout-copy {
      width: 100%;
      margin-top: 0;
      opacity: 1;
      transform: translateY(0);
    }

    .project-stack-card.is-reversed .project-callout-line {
      grid-column: auto;
      grid-row: auto;
      background: linear-gradient(180deg, rgba(74, 222, 128, 0.68), rgba(255, 255, 255, 0.08));
    }

    .project-stack-card.is-reversed .project-node-dot {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 680px) {
    .projects-hero-stage {
      min-height: auto;
      padding-top: 6.5rem;
    }

    .projects-title {
      font-size: clamp(2.8rem, 16vw, 4.4rem);
    }

    .projects-lede {
      font-size: 0.98rem;
      line-height: 1.68;
    }

    .projects-command-line {
      font-size: 0.65rem;
      gap: 0.45rem 0.65rem;
    }

    .projects-command-line span {
      width: 100%;
      overflow-wrap: anywhere;
    }

    .projects-stack-track {
      gap: 3rem;
    }

    .projects-stat-grid {
      grid-template-columns: 1fr;
    }

    .projects-stat-panel strong {
      font-size: 1.7rem;
    }

    .project-panel-copy h2 {
      font-size: clamp(1.8rem, 10vw, 2.6rem);
    }

    .project-panel-copy {
      padding: 1.1rem;
    }

    .project-panel-copy p,
    .project-callout-copy p {
      font-size: 0.95rem;
      line-height: 1.6;
    }

    .project-callout-copy {
      padding: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-stack-card,
    .project-stack-lock,
    .project-panel-media,
    .project-node-callout,
    .project-callout-copy,
    .project-node-dot,
    .project-callout-line,
    .projects-grid-plane,
    .projects-depth-line {
      transition: none;
      transform: none;
      will-change: auto;
    }

    .project-panel-scan {
      transition: none;
    }
  }
</style>

<script>
  const reduceProjectsMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-projects-reveal]')
  const depthCards = document.querySelectorAll<HTMLElement>('[data-project-depth]')
  const layerTargets = document.querySelectorAll<HTMLElement>('[data-projects-layer]')
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-project-filter]')
  const projectCards = document.querySelectorAll<HTMLElement>('[data-project-card]')
  const countLabel = document.querySelector<HTMLElement>('[data-project-count]')

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible')
          revealObserver.unobserve(entry.target)
        }
      })
    },
    { threshold: 0.18, rootMargin: '0px 0px -8% 0px' },
  )

  revealTargets.forEach((target) => revealObserver.observe(target))

  function resetProjectsDepth() {
    layerTargets.forEach((target) => target.style.removeProperty('--layer-y'))
    depthCards.forEach((card) => {
      card.style.transform = ''
      card.classList.remove('is-focused')
      card.querySelector<HTMLElement>('[data-project-lock]')?.style.removeProperty('transform')
      card.querySelector<HTMLElement>('[data-project-media]')?.style.removeProperty('transform')
      card.querySelector<HTMLElement>('[data-project-callout]')?.style.removeProperty('transform')
    })
  }

  function updateProjectsDepth() {
    if (reduceProjectsMotion || window.innerWidth <= 980) {
      resetProjectsDepth()
      return
    }

    layerTargets.forEach((target) => {
      const speed = Number(target.dataset.speed ?? 0)
      target.style.setProperty('--layer-y', `${window.scrollY * speed}px`)
    })

    depthCards.forEach((card) => {
      if (card.classList.contains('is-hidden')) return

      const rect = card.getBoundingClientRect()
      const travel = Math.max(rect.height - window.innerHeight * 0.36, 1)
      const progress = Math.max(0, Math.min(1, (window.innerHeight * 0.68 - rect.top) / travel))
      const focusStart = 0.28
      const focusEnd = 0.72
      const distance =
        progress < focusStart
          ? (progress - focusStart) / focusStart
          : progress > focusEnd
            ? (progress - focusEnd) / (1 - focusEnd)
            : 0
      const clamped = Math.max(-1, Math.min(1, distance))
      const side = Number(card.style.getPropertyValue('--stack-side') || 1)
      const focus = clamped === 0 ? 1 : Math.max(0, 1 - Math.min(Math.abs(clamped) / 0.72, 1))
      const eased = 1 - focus
      const z = -Math.abs(clamped) * 210 * eased
      const y = 0
      const x = side * clamped * 86 * eased
      const rotateY = side * clamped * -21 * eased
      const rotateX = clamped * 6 * eased
      const scale = 1 - Math.abs(clamped) * 0.12 * eased

      const lock = card.querySelector<HTMLElement>('[data-project-lock]')
      if (lock) {
        lock.style.transform = `translate3d(${x}px, ${y}px, ${z}px) rotateY(${rotateY}deg) rotateX(${rotateX}deg) scale(${scale})`
      }
      card.classList.toggle('is-focused', focus > 0.36)

      const media = card.querySelector<HTMLElement>('[data-project-media]')
      const callout = card.querySelector<HTMLElement>('[data-project-callout]')

      if (media) {
        media.style.transform = `translate3d(0, ${clamped * 36 * eased}px, ${70 + focus * 24}px)`
      }

      if (callout) {
        callout.style.transform = `translate3d(${side * clamped * -42 * eased}px, ${clamped * -18 * eased}px, ${160 + focus * 32}px) scale(${0.96 + focus * 0.04})`
      }
    })
  }

  function applyProjectFilter(filter: string) {
    let visibleCount = 0

    projectCards.forEach((card) => {
      const tags = (card.dataset.projectTags ?? '').split('|')
      const isVisible = filter === 'all' || tags.includes(filter)
      card.classList.toggle('is-hidden', !isVisible)
      if (isVisible) visibleCount += 1
    })

    if (countLabel) {
      countLabel.textContent = String(visibleCount)
    }

    updateProjectsDepth()
  }

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.projectFilter ?? 'all'
      filterButtons.forEach((item) => item.classList.toggle('is-active', item === button))
      applyProjectFilter(filter)
    })
  })

  updateProjectsDepth()
  window.addEventListener('scroll', updateProjectsDepth, { passive: true })
  window.addEventListener('resize', updateProjectsDepth)
</script>
